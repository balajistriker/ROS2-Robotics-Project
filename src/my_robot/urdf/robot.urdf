<?xml version="1.0"?>

<robot name="my_robot">

    <!-- ========================================================= -->
    <!-- BASE LINK                                                  -->
    <!-- ========================================================= -->

    <link name="base_link">

        <visual>
            <geometry>
                <box size="1.0 0.6 0.3"/>
            </geometry>

            <material name="blue">
                <color rgba="0.1 0.2 0.8 1.0"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <box size="0.6 0.4 0.2"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="5.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia
                ixx="0.12"
                ixy="0.0"
                ixz="0.0"
                iyy="0.18"
                iyz="0.0"
                izz="0.24"/>
        </inertial>

    </link>


    <!-- ========================================================= -->
    <!-- LEFT WHEEL                                                 -->
    <!-- ========================================================= -->

    <link name="left_wheel">

        <!-- Main wheel -->
        <!-- Cylinder is rotated so its axle is along Y -->

        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="0.15" length="0.12"/>
            </geometry>

            <material name="left_wheel_black">
                <color rgba="0.02 0.02 0.02 1.0"/>
            </material>
        </visual>


        <!-- ===================================================== -->
        <!-- LEFT WHEEL MARKERS                                    -->
        <!-- ===================================================== -->

        <!-- Red marker -->
        <visual>
            <origin xyz="0.10 0.07 0"/>

            <geometry>
                <sphere radius="0.035"/>
            </geometry>

            <material name="left_red">
                <color rgba="1.0 0.0 0.0 1.0"/>
            </material>
        </visual>


        <!-- Yellow marker -->
        <visual>
            <origin xyz="-0.10 0.07 0"/>

            <geometry>
                <sphere radius="0.035"/>
            </geometry>

            <material name="left_yellow">
                <color rgba="1.0 1.0 0.0 1.0"/>
            </material>
        </visual>


        <!-- Green marker -->
        <visual>
            <origin xyz="0 0.07 0.10"/>

            <geometry>
                <sphere radius="0.035"/>
            </geometry>

            <material name="left_green">
                <color rgba="0.0 1.0 0.0 1.0"/>
            </material>
        </visual>


        <!-- White marker -->
        <visual>
            <origin xyz="0 0.07 -0.10"/>

            <geometry>
                <sphere radius="0.035"/>
            </geometry>

            <material name="left_white">
                <color rgba="1.0 1.0 1.0 1.0"/>
            </material>
        </visual>


        <!-- Wheel collision -->
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="0.15" length="0.12"/>
            </geometry>
        </collision>


        <inertial>
            <mass value="0.5"/>

            <origin xyz="0 0 0" rpy="0 0 0"/>

            <inertia
                ixx="0.0025"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0025"
                iyz="0.0"
                izz="0.0025"/>
        </inertial>

    </link>


    <!-- ========================================================= -->
    <!-- LEFT WHEEL JOINT                                           -->
    <!-- ========================================================= -->

    <joint name="left_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="left_wheel"/>

        <!-- Left wheel -->
        <origin xyz="0 0.36 -0.15" rpy="0 0 0"/>

        <!-- Wheel axle -->
        <axis xyz="0 1 0"/>

    </joint>


    <!-- ========================================================= -->
    <!-- RIGHT WHEEL                                                -->
    <!-- ========================================================= -->

    <link name="right_wheel">

        <!-- Main wheel -->

        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="0.15" length="0.12"/>
            </geometry>

            <material name="right_wheel_black">
                <color rgba="0.02 0.02 0.02 1.0"/>
            </material>
        </visual>


        <!-- ===================================================== -->
        <!-- RIGHT WHEEL MARKERS                                   -->
        <!-- ===================================================== -->

        <!-- Red marker -->
        <visual>
            <origin xyz="0.10 -0.07 0"/>

            <geometry>
                <sphere radius="0.035"/>
            </geometry>

            <material name="right_red">
                <color rgba="1.0 0.0 0.0 1.0"/>
            </material>
        </visual>


        <!-- Yellow marker -->
        <visual>
            <origin xyz="-0.10 -0.07 0"/>

            <geometry>
                <sphere radius="0.035"/>
            </geometry>

            <material name="right_yellow">
                <color rgba="1.0 1.0 0.0 1.0"/>
            </material>
        </visual>


        <!-- Green marker -->
        <visual>
            <origin xyz="0 -0.07 0.10"/>

            <geometry>
                <sphere radius="0.035"/>
            </geometry>

            <material name="right_green">
                <color rgba="0.0 1.0 0.0 1.0"/>
            </material>
        </visual>


        <!-- White marker -->
        <visual>
            <origin xyz="0 -0.07 -0.10"/>

            <geometry>
                <sphere radius="0.035"/>
            </geometry>

            <material name="right_white">
                <color rgba="1.0 1.0 1.0 1.0"/>
            </material>
        </visual>


        <!-- Wheel collision -->

        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="0.15" length="0.12"/>
            </geometry>
        </collision>


        <inertial>
            <mass value="0.5"/>

            <origin xyz="0 0 0" rpy="0 0 0"/>

            <inertia
                ixx="0.0025"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0025"
                iyz="0.0"
                izz="0.0025"/>
        </inertial>

    </link>


    <!-- ========================================================= -->
    <!-- RIGHT WHEEL JOINT                                          -->
    <!-- ========================================================= -->

    <joint name="right_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="right_wheel"/>

        <!-- Right wheel -->
        <origin xyz="0 -0.36 -0.15" rpy="0 0 0"/>

        <!-- Wheel axle -->
        <axis xyz="0 1 0"/>

    </joint>


    <!-- ========================================================= -->
    <!-- CASTER WHEEL                                               -->
    <!-- ========================================================= -->

    <link name="caster_wheel">

        <visual>

            <geometry>
                <sphere radius="0.10"/>
            </geometry>

            <material name="gray">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>

        </visual>


        <collision>

            <geometry>
                <sphere radius="0.10"/>
            </geometry>

        </collision>


        <inertial>

            <mass value="0.5"/>

            <origin xyz="0 0 0" rpy="0 0 0"/>

            <inertia
                ixx="0.0025"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0025"
                iyz="0.0"
                izz="0.0025"/>

        </inertial>

    </link>


    <!-- ========================================================= -->
    <!-- CASTER JOINT                                               -->
    <!-- ========================================================= -->

    <joint name="caster_joint" type="fixed">

        <parent link="base_link"/>
        <child link="caster_wheel"/>

        <origin xyz="-0.40 0 -0.20" rpy="0 0 0"/>

    </joint>


    <!-- ========================================================= -->
    <!-- GAZEBO / GZ SIM PLUGINS                                    -->
    <!-- ========================================================= -->

    <gazebo>

        <!-- ===================================================== -->
        <!-- DIFFERENTIAL DRIVE                                    -->
        <!-- ===================================================== -->

        <plugin
            filename="libignition-gazebo-diff-drive-system.so"
            name="ignition::gazebo::systems::DiffDrive">

            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>

            <wheel_separation>0.72</wheel_separation>
            <wheel_radius>0.15</wheel_radius>

            <topic>/model/my_robot/cmd_vel</topic>

            <odom_topic>/model/my_robot/odometrys</odom_topic>

            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>

            <odom_publish_frequency>50</odom_publish_frequency>

        </plugin>


        <!-- ===================================================== -->
        <!-- JOINT STATE PUBLISHER                                 -->
        <!-- ===================================================== -->

        <plugin
            filename="libignition-gazebo-joint-state-publisher-system.so"
            name="ignition::gazebo::systems::JointStatePublisher">

            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>

        </plugin>

    </gazebo>
    
      <!-- ====================================== -->
  <!-- LIDAR LINK -->
  <!-- ====================================== -->

  <link name="lidar_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>

      <material name="lidar_material">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>

      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>

  </link>
<!-- ====================================== -->
<!-- IMU LINK -->
<!-- ====================================== -->

<link name="imu_link">

    <visual>
        <geometry>
            <box size="0.06 0.06 0.03"/>
        </geometry>

        <material name="imu_material">
            <color rgba="0.8 0.2 0.2 1.0"/>
        </material>
    </visual>

    <inertial>
        <mass value="0.05"/>
        <inertia
            ixx="0.0001"
            ixy="0.0"
            ixz="0.0"
            iyy="0.0001"
            iyz="0.0"
            izz="0.0001"/>
    </inertial>

</link>

<!-- ====================================== -->

  <!-- RGB CAMERA LINK -->

  <!-- ====================================== -->

  <link name="camera_link">

<visual>
  <geometry>
    <box size="0.08 0.06 0.04"/>
  </geometry>

  <material name="camera_material">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
</visual>

<collision>
  <geometry>
    <box size="0.08 0.06 0.04"/>
  </geometry>
</collision>

<inertial>
  <mass value="0.05"/>
  <inertia
    ixx="0.0001"
    ixy="0.0"
    ixz="0.0"
    iyy="0.0001"
    iyz="0.0"
    izz="0.0001"/>
</inertial>

  </link>

  <!-- ====================================== -->
  <!-- CAMERA FIXED JOINT -->

  <!-- ====================================== -->

<joint name="camera_joint" type="fixed">

<parent link="base_link"/>
<child link="camera_link"/>

<!-- Front of robot, facing +X -->
<origin xyz="0.50 0 0.05" rpy="0 0 0"/>

  </joint>
<!-- ====================================== -->
<!-- IMU FIXED JOINT -->
<!-- ====================================== -->

<joint name="imu_joint" type="fixed">

    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin xyz="0 0 0.25" rpy="0 0 0"/>

</joint>
  
  <!-- ====================================== -->
  <!-- LIDAR FIXED JOINT -->
  <!-- ====================================== -->

  <joint name="lidar_joint" type="fixed">

    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin xyz="0 0 0.20" rpy="0 0 0"/>

  </joint>
  <!-- LIDAR SENSOR CONFIGURATION -->
<gazebo reference="lidar_link">

  <sensor name="lidar_sensor" type="gpu_lidar">
    <pose>0 0 0 0 0 0</pose>

    <topic>scan</topic>
    <update_rate>10</update_rate>

    <lidar>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>

      <range>
        <min>0.12</min>
        <max>8.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>

    <always_on>true</always_on>
    <visualize>true</visualize>

  </sensor>

</gazebo>
<!-- ====================================== -->
<!-- IMU SENSOR CONFIGURATION -->
<!-- ====================================== -->

<gazebo reference="imu_link">

    <sensor name="imu_sensor" type="imu">

        <always_on>true</always_on>

        <update_rate>100</update_rate>

        <visualize>false</visualize>

        <topic>/imu</topic>

    </sensor>

</gazebo>

  <!-- RGB CAMERA SENSOR -->

  <!-- ====================================== -->

<gazebo reference="camera_link">

<sensor name="rgb_camera" type="camera">

  <pose>0 0 0 0 0 0</pose>

  <always_on>true</always_on>
  <update_rate>5</update_rate>
  <visualize>true</visualize>

  <topic>/camera/image_raw</topic>

  <camera>

    <horizontal_fov>1.047</horizontal_fov>

    <image>
      <width>320</width>
      <height>240</height>
      <format>R8G8B8</format>
    </image>

    <clip>
      <near>0.1</near>
      <far>20.0</far>
    </clip>

  </camera>

</sensor>
<!-- DEPTH CAMERA -->

<sensor name="depth_camera" type="depth_camera">

    <pose>0 0 0 0 0 0</pose>

    <always_on>true</always_on>

    <update_rate>5</update_rate>

    <visualize>true</visualize>

    <topic>/camera/depth/image_raw</topic>

    <camera>

        <horizontal_fov>1.047</horizontal_fov>

        <image>
            <width>320</width>
            <height>240</height>
            <format>R_FLOAT32</format>
        </image>

        <clip>
            <near>0.1</near>
            <far>8.0</far>
        </clip>

    </camera>

</sensor>

</gazebo> 
</robot>
