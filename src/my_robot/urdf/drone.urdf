<?xml version="1.0"?>
<robot name="cargo_quadcopter">
  <!-- Detailed visual meshes; simplified collision geometry for physics.
       Approximate dimensions in metres. +X forward, +Y left, +Z up.
       Sensors intentionally excluded. -->
  <material name="body"><color rgba="0.13 0.15 0.18 1"/></material>
  <material name="carbon"><color rgba="0.035 0.045 0.055 1"/></material>
  <material name="orange"><color rgba="1.0 0.28 0.015 1"/></material>
  <material name="prop"><color rgba="0.025 0.03 0.035 1"/></material>
  <material name="cargo"><color rgba="0.16 0.18 0.21 1"/></material>
  <material name="rubber"><color rgba="0.025 0.03 0.035 1"/></material>

  <link name="body_link">
    <visual><geometry><mesh filename="package://my_robot/meshes/body_shell.stl"/></geometry><material name="body"/></visual>
    <visual><origin xyz="0 0 0.095"/><geometry><mesh filename="package://my_robot/meshes/top_deck.stl"/></geometry><material name="carbon"/></visual>
    <collision><geometry><box size="0.46 0.34 0.16"/></geometry></collision>
    <inertial><mass value="2.8"/><inertia ixx="0.0308" ixy="0" ixz="0" iyy="0.0569" iyz="0" izz="0.0733"/></inertial>
  </link>

  <link name="front_left_arm">
    <visual><geometry><mesh filename="package://my_robot/meshes/carbon_arm.stl"/></geometry><material name="carbon"/></visual>
    <collision><origin xyz="0.265 0 0" rpy="0 1.570796 0"/><geometry><cylinder radius="0.032" length="0.53"/></geometry></collision>
    <inertial><origin xyz="0.265 0 0"/><mass value="0.22"/><inertia ixx="0.00015" ixy="0" ixz="0" iyy="0.0053" iyz="0" izz="0.0054"/></inertial>
  </link>
  <joint name="front_left_arm_fixed" type="fixed"><parent link="body_link"/><child link="front_left_arm"/><origin xyz="0.12 0.12 0.015" rpy="0 0 0.785398"/></joint>
  <link name="front_left_motor">
    <visual><geometry><mesh filename="package://my_robot/meshes/motor_pod.stl"/></geometry><material name="orange"/></visual>
    <collision><geometry><cylinder radius="0.065" length="0.075"/></geometry></collision>
    <inertial><mass value="0.18"/><inertia ixx="0.00022" ixy="0" ixz="0" iyy="0.00022" iyz="0" izz="0.00038"/></inertial>
  </link>
  <joint name="front_left_motor_fixed" type="fixed"><parent link="front_left_arm"/><child link="front_left_motor"/><origin xyz="0.53 0 0.025"/></joint>
  <link name="front_left_propeller">
    <visual><origin xyz="0 0 0.045"/><geometry><mesh filename="package://my_robot/meshes/two_blade_propeller.stl"/></geometry><material name="prop"/></visual>
    <collision><origin xyz="0 0 0.045"/><geometry><cylinder radius="0.17" length="0.008"/></geometry></collision>
    <inertial><mass value="0.045"/><inertia ixx="0.00011" ixy="0" ixz="0" iyy="0.00011" iyz="0" izz="0.00022"/></inertial>
  </link>
  <joint name="front_left_propeller_spin" type="continuous"><parent link="front_left_motor"/><child link="front_left_propeller"/><origin xyz="0 0 0.045"/><axis xyz="0 0 1"/></joint>

