<?xml version="1.0"?>
<sdf version="1.8">

  <world name="lidar_world">

    <gravity>0 0 -9.8</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Gazebo System Plugins -->

    <plugin
      filename="ignition-gazebo6-physics-system"
      name="ignition::gazebo::systems::Physics"/>

    <plugin
      filename="ignition-gazebo6-user-commands-system"
      name="ignition::gazebo::systems::UserCommands"/>

    <plugin
      filename="ignition-gazebo6-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster"/>

    <plugin
      filename="ignition-gazebo6-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- IMU System Plugin -->

    <plugin
      filename="ignition-gazebo6-imu-system"
      name="ignition::gazebo::systems::Imu"/>

    <!-- GROUND PLANE -->

    <model name="ground_plane">
      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.12 0.12 0.15 1</ambient>
            <diffuse>0.18 0.18 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>

        </visual>

      </link>
    </model>

  </world>

</sdf>